# Forge service configuration (copy to .env; loaded by forge.service via EnvironmentFile)
FORGE_DATA_DIR=/opt/banksy/forge/data
FORGE_OUTBOX=/opt/banksy/forge/outbox
FORGE_PUBLIC_URL=https://forge.banksyai.com
FORGE_OLLAMA_URL=http://127.0.0.1:11434
FORGE_OLLAMA_MODELS=qwen3:4b
FORGE_LLM_TIMEOUT=8
# Optional cloud fallback (any OpenAI-compatible endpoint); leave blank to disable
FORGE_CLOUD_BASE_URL=
FORGE_CLOUD_API_KEY=
FORGE_CLOUD_MODEL=gpt-4o-mini
