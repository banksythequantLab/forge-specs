        SortIndex:
          Variable: 3
        Step:
          Variable: 0.009999999776482582
        Title:
          String: Overhang Shading On
        Tooltip:
          String: "1 shows the red overhang shading, 0 hides it. Fades out after a successful export."
      PositionX: -620
      PositionY: 360
      TemplateID: nodes_inputs_parameters_float
      Title1: Float Parameter
      Title2: Overhang Shading On
    Node4:
      DependencyIndex: 4
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            // Forge - red shading on faces that would need support.
            //
            // A face needs support when it points more than 45 degrees downward,
            // i.e. dot(worldNormal, (0,-1,0)) > 0.707, AND it is not the flat base
            // resting on the print bed (more than 0.5 mm above the lowest point).
            // World units are centimetres, so 0.5 mm = 0.05.

            input_vec4 bodyColor;
            input_vec4 overhangColor;
            input_float minY;
            input_float overhangOn;
            output_vec4 result;

            void main()
            {
            	vec3 p = system.getSurfacePositionWorldSpace();

            	// The true face angle, not the smoothed vertex normal. The GLB
            	// arrives with interpolated normals, so a flat downward face
            	// would otherwise only cross the 45 degree threshold in a thin
            	// band instead of reading red all over.
            	vec3 shading = normalize(system.getSurfaceNormalWorldSpace());
            	vec3 n = normalize(cross(dFdx(p), dFdy(p)));
            	if (dot(n, shading) < 0.0) n = -n;

            	// Steeper than 45 degrees downward.
            	float steep = step(0.707, -n.y);
            	// Not the base that rests on the bed.
            	float aboveBase = step(minY + 0.05, p.y);
            	float isOverhang = steep * aboveBase * step(0.5, overhangOn);

            	vec4 tint = mix(bodyColor, overhangColor, isOverhang);

            	// Gentle top-lit shading so the silhouette reads in 3D without
            	// going dark - the display is additive, dark means invisible.
            	float shade = 0.78 + 0.22 * clamp(n.y * 0.5 + 0.5, 0.0, 1.0);

            	result = vec4(tint.rgb * shade, tint.a);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Overhang Shading
        UseExternalFile:
          Variable: false
        bodyColor:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        overhangColor:
          Connection0:
            NodeLevelID: 2
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        minY:
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: 0.0
        overhangOn:
          Connection0:
            NodeLevelID: 4
            PortID: Output
          Variable: 0.0
        ngs_Height:
          Variable: 520
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -180
      PositionY: 90
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: Overhang Shading
